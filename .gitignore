# ==========================================
# Discord AI Profiler & Digital Twin
# Git Ignore Configuration
# ==========================================

# Ambientes y Entornos Virtuales de Python
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node.js y Gestores de Paquetes
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/

# Almacenamiento Local de Grabaciones y Modelos (DATOS PESADOS Y PRIVADOS)
# Se preserva la estructura de carpetas mediante .gitkeep
storage/raw_sessions/*
!storage/raw_sessions/.gitkeep

storage/clean_samples/*
!storage/clean_samples/.gitkeep

storage/transcripts/*
!storage/transcripts/.gitkeep

storage/profiles/*
!storage/profiles/.gitkeep

storage/twin_outputs/*
!storage/twin_outputs/.gitkeep

# Checkpoints y Pesos de Modelos Locales (Whisper, XTTS, F5-TTS)
models/
*.pt
*.bin
*.onnx
*.safetensors

# Credenciales, Tokens y Variables de Entorno (CRÍTICO: NUNCA COMMITEAR)
.env
.env.local
.env.*.local
*.pem
*.key
token.txt

# IDEs y Editores de Código
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs y Archivos Temporales
*.log
logs/
temp/
tmp/
*.tmp

# Clave de API de Google Gemini (Obtén la tuya en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo predeterminado para análisis psicológico profundo:
# Recomendado: gemini-2.5-flash (rápido y eficiente) o gemini-2.5-pro (máximo detalle)
GEMINI_MODEL=gemini-2.5-flash

# API de respaldo gratuita para LLaMA 3.3 (Groq Cloud):
# Obtén tu clave 100% gratuita sin tarjeta en https://console.groq.com/keys
GROQ_API_KEY=tu_groq_api_key_aqui
LLAMA_MODEL=llama-3.3-70b-versatile
